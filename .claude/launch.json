{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "garrettstoll-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "worldmap-isolated",
      "runtimeExecutable": "npx",
