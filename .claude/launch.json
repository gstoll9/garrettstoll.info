        "dev",
        "-p",
        "3007"
      ],
      "port": 3007,
      "env": {
        "NEXT_DIST_DIR": ".next-isolated"
      }
    },
    {
      "name": "brain-isolated",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3008"
      ],
      "port": 3008,
      "env": {
        "NEXT_DIST_DIR": ".next-brain"
      }
    }
  ]
}
